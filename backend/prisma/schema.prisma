// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================
// UTILISATEURS (Admin, Agent, Technicien...)
// =============================================
model Utilisateur {
  id                String     @id @default(cuid())
  nom               String
  email             String     @unique
  telephone         String?
  motDePasse        String
  role              Role       @default(AGENT)
  statut            StatutUser @default(ACTIF)
  photoProfil       String?
  permissions       String[]   @default([])
  derniereConnexion DateTime?
  refreshToken      String?
  // Rôle PARTENAIRE : nom de l'établissement (hôtel, agence) affiché sur ses réservations
  partenaireNom     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  logsCreated  Log[]
  reservations ReservationSIM[]
}

enum Role {
  ADMIN
  AGENT
  TECHNICIEN
  LECTURE_SEULE
  PARTENAIRE // hôtel / agence : accès limité à ses propres réservations SIM
}

enum StatutUser {
  ACTIF
  BLOQUE
  INACTIF
}

// =============================================
// CLIENTS (créés via la borne SIM)
// =============================================
model Client {
  id            String     @id @default(cuid())
  numeroDossier String     @unique @default(cuid())
  nom           String
  prenom        String
  dateNaissance DateTime?
  lieuNaissance String?
  nationalite   String?    @default("Guinéenne")
  profession    String?
  typeClient    TypeClient @default(RESIDENT)

  // Pièce d'identité
  typePiece   String?
  numeroPiece String?
  photoPiece  String? // URL image stockée

  // Selfie
  photoSelfie String? // URL image stockée

  // Contact
  telephone String?
  email     String?

  statut StatutClient @default(EN_ATTENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  demandes DemandeSIM[]
}

enum TypeClient {
  RESIDENT
  ETRANGER
}

enum StatutClient {
  EN_ATTENTE
  VALIDE
  REJETE
}

// =============================================
// OFFRES SIM
// =============================================
model Offre {
  id          String    @id @default(cuid())
  nom         String
  description String?
  prix        Float
  type        TypeOffre
  duree       String? // "30 jours", "illimité"
  data        String? // "5 Go", "Illimité"
  appels      String? // "100 min", "Illimité"
  sms         String? // "50 SMS"
  estActif    Boolean   @default(true)
  couleur     String? // Pour l'affichage frontend

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  demandes     DemandeSIM[]
  reservations ReservationSIM[]
}

enum TypeOffre {
  SIM_STANDARD
  SIM_INTERNET
  SIM_ETUDIANT
  SIM_ENTREPRISE
  SIM_ESIM
  RECHARGE
  FORFAIT_PASS
  DEPOT
}

// =============================================
// DEMANDES SIM (Nouvelle SIM + Réactivation)
// =============================================
model DemandeSIM {
  id            String        @id @default(cuid())
  numeroDossier String        @unique
  type          TypeDemande
  statut        StatutDemande @default(EN_ATTENTE_VALIDATION)

  // Infos client
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Offre choisie (pour nouvelle SIM)
  offreId String?
  offre   Offre?  @relation(fields: [offreId], references: [id])

  // Format de la SIM (pour NOUVELLE_SIM : carte physique ou eSIM)
  formatSim FormatSim @default(PHYSIQUE)

  // Choix du client (fait sur l'écran de confirmation finale) d'activer un
  // compte Orange Money sur ce numéro. null = pas encore demandé / non
  // applicable (ex: RECHARGE). La création réelle du compte se fait côté
  // Orange — ce champ capture juste l'intention du client pour le back-office.
  compteOrangeMoney Boolean?

  // Réactivation
  numeroAReactiver  String?
  motifReactivation String?

  // Opération sur la ligne chez l'opérateur (OPS Orange — simulé par ops-mock pour l'instant) :
  // nouvelle SIM = création de la ligne, réactivation = remise en service, recharge = ligne confirmée
  imsi              String?           @unique // IMSI de la carte délivrée (10 chiffres) — nouvelle SIM, réactivation sur perte
  iccid             String?           @unique // n° de série de la puce, lu par le distributeur SK-AD3
  numeroAttribue    String?           @unique // numéro de téléphone créé (9 chiffres)
  statutActivation  StatutActivation?
  messageActivation String? // réponse ou erreur OPS
  activeeLe         DateTime?

  // Résultat vérification IA (à connecter plus tard)
  scoreVerification  Float?
  verificationOCR    Boolean?
  verificationSelfie Boolean?

  // Commentaires admin
  commentaireAdmin String?
  traitePar        String? // nom de l'agent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paiement    Paiement?
  reservation ReservationSIM?
}

enum TypeDemande {
  NOUVELLE_SIM
  REACTIVATION
  RECHARGE
}

enum FormatSim {
  PHYSIQUE
  ESIM
}

enum StatutActivation {
  ACTIVEE
  ECHEC
}

// Crédit d'appel par numéro, tenu par N'ma SIM : OPS (action ACTIVATION) n'a pas de champ montant,
// la recharge est confirmée côté opérateur et le montant cumulé ici (simulation).
model SoldeLigne {
  numero    String   @id // 9 chiffres
  solde     Float    @default(0) // GNF
  updatedAt DateTime @updatedAt
}

enum StatutDemande {
  EN_ATTENTE_VALIDATION
  EN_COURS_DE_TRAITEMENT
  VALIDEE
  REJETEE
}

// =============================================
// PAIEMENTS
// =============================================
model Paiement {
  id        String     @id @default(cuid())
  demandeId String     @unique
  demande   DemandeSIM @relation(fields: [demandeId], references: [id])

  montant         Float
  devise          String          @default("GNF")
  methodePaiement MethodePaiement
  statut          StatutPaiement  @default(EN_ATTENTE)

  // Référence paiement externe (Orange Money, etc.)
  referenceExterne String?
  numeroPaieur     String? // numéro de téléphone utilisé

  confirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MethodePaiement {
  ORANGE_MONEY
  MTN_MOBILE_MONEY
  WAVE
  CARTE_BANCAIRE
  ESPECES
  PREPAYE // payé à l'avance via une réservation (hôtel / agence partenaire)
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  REMBOURSE
}

// =============================================
// RÉSERVATIONS SIM (voyageurs — créées par un hôtel/agence partenaire ou l'admin)
// Le voyageur reçoit un code ; à la borne : code → passeport (doit correspondre) → selfie → SIM.
// =============================================
model ReservationSIM {
  id     String            @id @default(cuid())
  code   String            @unique // ex. NMA-7K4P-92QX (usage unique)
  statut StatutReservation @default(ACTIVE)

  // Voyageur
  nom             String
  prenom          String
  nationalite     String?
  numeroPasseport String // doit correspondre au passeport scanné
  email           String?
  telephone       String?

  // Produit réservé
  formatSim       FormatSim @default(PHYSIQUE)
  offreId         String? // forfait eSIM / offre ajoutée
  offre           Offre?    @relation(fields: [offreId], references: [id])
  montantRecharge Float? // recharge incluse (SIM physique)
  montant         Float // total prépayé (GNF)

  // Validité
  dateArrivee DateTime
  expireLe    DateTime // dateArrivee + 30 jours

  // Partenaire
  partenaireNom String // copie du nom de l'établissement
  creeParId     String
  creePar       Utilisateur @relation(fields: [creeParId], references: [id])

  // Utilisation à la borne
  utiliseeLe DateTime?
  demandeId  String?     @unique
  demande    DemandeSIM? @relation(fields: [demandeId], references: [id])

  // Reçu envoyé par e-mail au voyageur (dernier envoi réussi)
  recuEnvoyeLe DateTime?

  // Règlement : le partenaire a encaissé le voyageur, il reverse le montant à N'ma SIM
  regleLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creeParId])
  @@index([statut])
  @@index([partenaireNom])
}

enum StatutReservation {
  ACTIVE
  UTILISEE
  EXPIREE
  ANNULEE
}

// =============================================
// LOGS SYSTEME
// =============================================
model Log {
  id          String  @id @default(cuid())
  type        String // "Connexion", "Validation", "Paiement confirmé"...
  description String
  entiteId    String? // ID de la demande / client / user concerné
  entiteType  String? // "DemandeSIM", "Client", "Utilisateur"...

  utilisateurId String?
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id])

  createdAt DateTime @default(now())
}

// =============================================
// PARAMETRES SYSTEME
// =============================================
model ParametreSysteme {
  cle    String @id
  valeur String
  type   String @default("STRING") // "BOOLEAN", "STRING", "NUMBER"

  updatedAt DateTime @updatedAt
}

// =============================================
// BORNES KIOSK
// =============================================
model Borne {
  id              String      @id @default(cuid())
  numeroReference String      @unique // ex: BRN-001
  nom             String
  emplacement     String
  statut          StatutBorne @default(HORS_LIGNE)
  ip              String?
  technicien      String?     @default("Non assigné")
  derniereSynchro DateTime?
  cleActivation   String?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatutBorne {
  EN_LIGNE
  HORS_LIGNE
  EN_MAINTENANCE
}
